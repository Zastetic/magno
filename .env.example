# Barbearia Magno — variáveis de ambiente (copiar para .env.local)
MAGNO_PORTA=8100
# IMPORTANTE: manter o banco no ext4 do WSL, nunca em /mnt/d (DrvFs/9p).
# Medição real: 200 gravações em /mnt/d levaram 0,46 s contra 0,002 s no ext4 (~238x mais lento).
MAGNO_DB=/home/vh450/.local/share/magno/magno.db
MAGNO_TOKEN_TTL_MIN=1440
MAGNO_AMBIENTE=dev
# URL pública usada para montar o redirect do OAuth (tem que bater EXATAMENTE com a
# Authorized redirect URI cadastrada no Google):
MAGNO_URL_BASE=https://magnum.autoava.us

# ------------------------------------------------------- e-mail (código de 5 dígitos)
# modos: arquivo (não envia nada — grava em logs/emails/), smtp | resend | brevo
MAGNO_EMAIL_MODO=arquivo
MAGNO_EMAIL_DE=magnum@autoava.us
MAGNO_EMAIL_NOME=Barbearia Magnum
# envio real por SMTP (Brevo, Gmail com senha de app, SES…):
MAGNO_SMTP_HOST=
MAGNO_SMTP_PORTA=587
MAGNO_SMTP_USUARIO=
MAGNO_SMTP_SENHA=
# envio real por API (Resend: re_... | Brevo: xkeysib-...):
MAGNO_EMAIL_CHAVE=

# ---------------------------------------------------------------- login Google
# console.cloud.google.com → APIs e serviços → Credenciais → Criar ID do cliente OAuth
# (tipo: Aplicativo Web). Origens e redirects autorizados em docs/06-LOGIN.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://magnum.autoava.us/api/auth/google/callback

# Provedor de mentira, local: testa o fluxo inteiro sem credencial nenhuma.
# OBRIGATORIAMENTE vazio em produção.
GOOGLE_FAKE=

# Só ativar depois do domínio fixo no ar (sitekey é presa ao domínio):
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=

# ------------------------------------------------- proteções para uso público (F6)
# Freio por IP (server/limites.py). Deixe 1 atrás do túnel/Cloudflare: o IP do cliente vem
# de CF-Connecting-IP. Use 0 só se o serviço receber conexão direta (sem proxy).
MAGNO_ATRAS_DE_PROXY=1

# CAPTCHA Cloudflare Turnstile nas ações sensíveis (cadastro, código, login, agendamento).
# Crie o widget em dash.cloudflare.com → Turnstile e cole as duas chaves.
# Sem chave, o CAPTCHA fica desligado e o site funciona normalmente.
MAGNO_TURNSTILE_SITE=
MAGNO_TURNSTILE_SECRET=
# off = não usa | log = verifica e registra sem bloquear (comece por aqui) | on = bloqueia
MAGNO_TURNSTILE_MODO=
